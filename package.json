{
  "name": "clickered",
  "version": "0.3.0-rc.5",
  "description": "Replicate mouse clicks and drags from one window to a group of windows (Linux/X11, macOS, Windows).",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "Ian Wijma",
    "email": "ian@wij.ma"
  },
  "homepage": "https://github.com/ianwijma/clickered",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianwijma/clickered.git"
  },
  "bugs": {
    "url": "https://github.com/ianwijma/clickered/issues"
  },
  "keywords": [
    "x11",
    "linux",
    "macos",
    "windows",
    "electron",
    "multiboxing",
    "input",
    "mouse",
    "click",
    "automation",
    "xtest"
  ],
  "desktopName": "clickered.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "build:helper": "node scripts/build-helper.mjs",
    "dev": "npm run build:helper && electron-vite dev",
    "build": "npm run build:helper && electron-vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "docker build -t clickered-e2e -f e2e/Dockerfile . && docker run --rm --init --shm-size=512m clickered-e2e",
    "dist": "npm run build && node scripts/dist.mjs"
  },
  "dependencies": {
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "semver": "^7.8.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
